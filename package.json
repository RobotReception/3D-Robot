{
  "name": "robot-avatar-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rigged, programmable 3D robot avatar engine (three.js) with lip-sync, IK and a control studio.",
  "license": "MIT",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./viewer": {
      "types": "./dist-lib/viewer/RobotViewer.d.ts",
      "import": "./dist-lib/viewer.js",
      "default": "./dist-lib/viewer.js"
    },
    "./react": {
      "types": "./dist-lib/adapters/r3f.d.ts",
      "import": "./dist-lib/react.js",
      "default": "./dist-lib/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node tools/fix_declarations.mjs",
    "check:package": "npm run build:lib && node tests/package-check.mjs",
    "prepack": "npm run build:lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "model:build": "bash tools/build_models.sh",
    "audio:build": "tsx tools/make_test_audio.ts",
    "docs:gen": "tsx tools/gen_docs.ts",
    "ws:example": "node tools/ws_example_server.mjs",
    "api:server": "node tools/remote_api_server.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
