{
  "name": "robot-avatar-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rigged, programmable 3D robot avatar engine (three.js) with lip-sync, IK and a control studio.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "model:build": "bash tools/build_models.sh",
    "audio:build": "tsx tools/make_test_audio.ts",
    "docs:gen": "tsx tools/gen_docs.ts",
    "ws:example": "node tools/ws_example_server.mjs",
    "api:server": "node tools/remote_api_server.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
