# Copy to .env (never commit .env). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Models: check https://ai.google.dev/gemini-api/docs/models for the ones available to your key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Kore
# Persona
ROBOT_NAME=Razi
ROBOT_ORG=Al-Razi University
ROBOT_ROLE=reception assistant
# ROBOT_LANGUAGE=auto            # auto | ar | en
# ROBOT_EXTRA=Opening hours: Sunday to Thursday 8:00-15:00.
# PORT=8788
# RATE_CHAT_PER_MIN=30
